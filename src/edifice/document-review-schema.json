{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_name",
    "documents",
    "cross_document",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_name": {"type": "string", "minLength": 1, "maxLength": 240},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/document"}
    },
    "cross_document": {"$ref": "#/$defs/cross_document"},
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "owner-attested",
        "policy-verified",
        "unavailable",
        "policy-blocked",
        "trial-required",
        "not-applicable"
      ]
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_status"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "evidence_status": {"$ref": "#/$defs/status"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "source_url",
        "title",
        "evidence_status",
        "purpose",
        "summary",
        "key_claims",
        "strengths",
        "concerns",
        "questions",
        "proposed_feedback"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "source_url": {"type": "string", "format": "uri", "maxLength": 2000},
        "title": {"$ref": "#/$defs/text"},
        "evidence_status": {"$ref": "#/$defs/status"},
        "purpose": {"$ref": "#/$defs/text"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
        "key_claims": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/claim"}
        },
        "strengths": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "concerns": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "questions": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "proposed_feedback": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "cross_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "agreements",
        "conflicts",
        "gaps",
        "decision_points",
        "proposed_feedback"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
        "agreements": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "conflicts": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "gaps": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "decision_points": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        },
        "proposed_feedback": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    }
  }
}
