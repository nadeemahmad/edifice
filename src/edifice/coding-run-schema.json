{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "name",
    "status",
    "created_at",
    "objective",
    "persistence_reason",
    "classification",
    "review_on",
    "jira",
    "repository",
    "workstream",
    "active_mode",
    "mode_history",
    "learning_level",
    "context_manifest",
    "writable_paths",
    "required_checks",
    "prohibited_effects",
    "completion_criteria",
    "gates",
    "evidence",
    "assignment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^coding-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "ready-for-owner",
        "closed",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "persistence_reason": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "public",
        "netflix-internal",
        "netflix-confidential"
      ]
    },
    "review_on": {
      "type": "string",
      "format": "date"
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "url",
        "evidence_status"
      ],
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "evidence_status": {
          "enum": [
            "pending-verification",
            "verified",
            "not-applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "not-applicable"
              }
            }
          },
          "then": {
            "properties": {
              "key": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"
              }
            }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "branch",
        "revision",
        "working_tree"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "working_tree": {
          "const": "clean"
        }
      }
    },
    "workstream": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "active_mode": {
      "enum": [
        "research",
        "experiment",
        "design",
        "implementation",
        "verification",
        "review"
      ]
    },
    "mode_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "entered_at",
          "reason",
          "revision"
        ],
        "properties": {
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "learning_level": {
      "enum": [
        "brief",
        "understand",
        "practice"
      ]
    },
    "context_manifest": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "loaded_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "loaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "writable_paths": {
      "$ref": "#/$defs/string_list"
    },
    "required_checks": {
      "$ref": "#/$defs/string_list"
    },
    "prohibited_effects": {
      "$ref": "#/$defs/string_list"
    },
    "completion_criteria": {
      "$ref": "#/$defs/string_list"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "tdd",
        "verification",
        "review",
        "pr_draft"
      ],
      "properties": {
        "design": {
          "$ref": "#/$defs/gate"
        },
        "tdd": {
          "$ref": "#/$defs/gate"
        },
        "verification": {
          "$ref": "#/$defs/gate"
        },
        "review": {
          "$ref": "#/$defs/gate"
        },
        "pr_draft": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_records",
        "tdd_cycles",
        "verification_runs",
        "review_runs",
        "closeouts",
        "pr_drafts"
      ],
      "properties": {
        "design_records": {
          "$ref": "#/$defs/evidence_list"
        },
        "tdd_cycles": {
          "$ref": "#/$defs/evidence_list"
        },
        "verification_runs": {
          "$ref": "#/$defs/evidence_list"
        },
        "review_runs": {
          "$ref": "#/$defs/evidence_list"
        },
        "closeouts": {
          "$ref": "#/$defs/evidence_list"
        },
        "pr_drafts": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-launched",
            "launching",
            "launch-retryable",
            "launched",
            "launch-needs-review",
            "complete",
            "blocked"
          ]
        },
        "path": {
          "const": "agent-assignment.preview.json"
        },
        "runtime": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "sandbox": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "launch_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "launched_at": {
          "type": "string",
          "format": "date-time"
        },
        "instruction_sources": {
          "$ref": "#/$defs/string_list"
        },
        "launch_error": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "launching",
                  "launch-retryable",
                  "launched",
                  "launch-needs-review"
                ]
              }
            }
          },
          "then": {
            "required": [
              "runtime",
              "model",
              "sandbox",
              "launch_started_at",
              "thread_id",
              "turn_id",
              "project_id",
              "cwd",
              "instruction_sources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "launch-retryable",
                  "launch-needs-review"
                ]
              }
            }
          },
          "then": {
            "required": [
              "launch_error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "launched"
              }
            }
          },
          "then": {
            "required": [
              "launched_at"
            ],
            "properties": {
              "thread_id": {
                "type": "string",
                "minLength": 1
              },
              "turn_id": {
                "type": "string",
                "minLength": 1
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "research",
        "experiment",
        "design",
        "implementation",
        "verification",
        "review"
      ]
    },
    "gate": {
      "enum": [
        "required",
        "pending",
        "satisfied",
        "not-applicable",
        "blocked"
      ]
    },
    "evidence_list": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
