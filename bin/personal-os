#!/bin/zsh
set -eu

project_root="${0:A:h:h}"

export PERSONAL_OS_VAULT="${PERSONAL_OS_VAULT:-$HOME/Obsidian/personal-os}"
export PERSONAL_OS_AUDIT_ROOT="${PERSONAL_OS_AUDIT_ROOT:-$HOME/Library/Logs/personal-os/personal/audit}"
export PYTHONPATH="$project_root/src${PYTHONPATH:+:$PYTHONPATH}"

exec "$project_root/.venv/bin/python" -m personal_os "$@"
