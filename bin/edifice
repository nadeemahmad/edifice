#!/bin/zsh
set -eu

project_root="${0:A:h:h}"

export EDIFICE_VAULT="${EDIFICE_VAULT:-$HOME/Obsidian/edifice}"
export EDIFICE_AUDIT_ROOT="${EDIFICE_AUDIT_ROOT:-$HOME/Library/Logs/edifice/personal/audit}"
export EDIFICE_PERSONAL_LIBRARY="${EDIFICE_PERSONAL_LIBRARY:-$HOME/My Drive/Library}"
export EDIFICE_MIGRATIONS_ROOT="${EDIFICE_MIGRATIONS_ROOT:-$HOME/Library/Application Support/edifice/migrations}"
export PYTHONPATH="$project_root/src${PYTHONPATH:+:$PYTHONPATH}"

exec "$project_root/.venv/bin/python" -m edifice "$@"
